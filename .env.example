# Copy to .env and fill in. Never commit .env.
# All keys are server-side only (backend/.env), except EXPO_PUBLIC_* which ship to the client.

# --- Backend ---
# Gemini (voice + vision). Get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpAPI for Google Shopping price lookups. https://serpapi.com/
SERPAPI_KEY=

# Google Books API key (optional, raises rate limit). https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# OpenAI (fallback/alternative vision). Optional.
OPENAI_API_KEY=

# Server config
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default locale (overridden per-sweep by the user)
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD

# --- Frontend (Expo) ---
# Anything prefixed EXPO_PUBLIC_ is exposed to the client bundle.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
EXPO_PUBLIC_BACKEND_WS=ws://localhost:8000/ws/sweep
