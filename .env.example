# Copy to backend/.env and fill in. Never commit .env.

# Gemini (Live voice+vision + resolve). https://aistudio.google.com/apikey
# Requires a billed Google AI Studio / Gemini project — free tier cannot run a full sweep.
GEMINI_API_KEY=

# SerpAPI for Google Shopping price lookups. https://serpapi.com/
# Without it, the pipeline runs but every price is excluded and routed to the review queue.
SERPAPI_KEY=

# Google Books API key (optional, raises rate limit). https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated origins, or * for any (needed for TestFlight / web clients).
CORS_ORIGINS=*

# Default locale (overridden per-sweep by the user in the app)
DEFAULT_COUNTRY=US
DEFAULT_CURRENCY=USD
